{
  "items": [
    {
      "id": "1",
      "type": "text",
      "content": "Vehicle Dashboard",
      "fontSize": "large",
      "fontWeight": "bold",
      "align": "center",
      "padding": 2
    },
    {
      "id": "2",
      "type": "box",
      "padding": 2,
      "gap": 2,
      "align": "center",
      "items": [
        {
          "id": "2.1",
          "type": "card",
          "title": "Engine Temperature",
          "footer": "Updates every 3 seconds",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "2.1.1",
              "type": "numericDisplay",
              "content": "engineTemp",
              "label": "Temperature",
              "variant": "thermometer",
              "format": "standard",
              "decimals": 0,
              "suffix": "°C",
              "minValue": 0,
              "maxValue": 120,
              "thermometerHeight": 120,
              "gaugeColor": "error",
              "animateChanges": true
            }
          ]
        },
        {
          "id": "2.2",
          "type": "card",
          "title": "Fuel Tank",
          "footer": "Updates every 4 seconds",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "2.2.1",
              "type": "numericDisplay",
              "content": "fuelTank",
              "label": "Fuel Level",
              "variant": "bar",
              "format": "percentage",
              "decimals": 0,
              "minValue": 0,
              "maxValue": 100,
              "barHeight": 16,
              "barColor": "warning",
              "animateChanges": true
            }
          ]
        },
        {
          "id": "2.3",
          "type": "card",
          "title": "Battery",
          "footer": "Updates every 3 seconds",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "2.3.1",
              "type": "numericDisplay",
              "content": "batteryVoltage",
              "label": "Battery Voltage",
              "variant": "gauge",
              "format": "standard",
              "decimals": 1,
              "suffix": "V",
              "minValue": 10,
              "maxValue": 16,
              "gaugeSize": 140,
              "gaugeThickness": 10,
              "gaugeColor": "primary",
              "animateChanges": true
            }
          ]
        },
        {
          "id": "2.4",
          "type": "card",
          "title": "Speed",
          "footer": "Updates every 1 second",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "2.4.1",
              "type": "numericDisplay",
              "content": "speed",
              "label": "Current Speed",
              "variant": "text",
              "format": "standard",
              "decimals": 0,
              "suffix": "km/h",
              "minValue": 0,
              "maxValue": 200,
              "animateChanges": true
            },
            {
              "id": "2.4.2",
              "type": "historyDiagram",
              "content": "speed",
              "label": "Speed Over Time",
              "width": 600,
              "height": 300,
              "minValue": 0,
              "maxValue": 200,
              "lineColor": "#FF6B6B"
            }
          ]
        }
      ]
    },
    {
      "id": "3",
      "type": "box",
      "padding": 2,
      "gap": 2,
      "align": "center",
      "items": [
        {
          "id": "3.1",
          "type": "card",
          "title": "Doors & Lights",
          "footer": "Safety status",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "3.1.1",
              "type": "binarySwitch",
              "content": "driverDoor",
              "label": "Driver Door",
              "onLabel": "Open",
              "offLabel": "Closed",
              "size": "medium",
              "onStatusColor": "error.main",
              "offStatusColor": "success.main"
            },
            {
              "id": "3.1.2",
              "type": "binarySwitch",
              "content": "headlights",
              "label": "Headlights",
              "onLabel": "On",
              "offLabel": "Off",
              "size": "medium",
              "onStatusColor": "warning.main",
              "offStatusColor": "text.secondary"
            }
          ]
        },
        {
          "id": "3.2",
          "type": "card",
          "title": "Engine & Parking",
          "footer": "Control status",
          "padding": 2,
          "gap": 1,
          "items": [
            {
              "id": "3.2.1",
              "type": "binarySwitch",
              "content": "engineRunning",
              "label": "Engine",
              "onLabel": "Running",
              "offLabel": "Stopped",
              "size": "medium",
              "onStatusColor": "success.main",
              "offStatusColor": "text.secondary"
            },
            {
              "id": "3.2.2",
              "type": "binarySwitch",
              "content": "parkingBrake",
              "label": "Parking Brake",
              "onLabel": "Engaged",
              "offLabel": "Released",
              "size": "medium",
              "onStatusColor": "info.main",
              "offStatusColor": "text.secondary"
            }
          ]
        }
      ]
    },
    {
      "id": "4",
      "type": "text",
      "content": "Vehicle telemetry — Essential metrics for safe driving",
      "fontSize": "small",
      "padding": 2,
      "align": "center",
      "color": "text.secondary"
    }
  ]
}
